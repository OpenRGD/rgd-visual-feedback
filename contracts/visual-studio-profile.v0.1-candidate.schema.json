{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrgd.org/candidate/visual/studio-profile.v0.1",
  "title": "Visual Effects Studio mapping profile v0.1 candidate — preview only",
  "description": "Portable, non-actuating desired-scene specification. Does not authorize applying effects, device pairing, remote lighting or motion commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "robot_id",
    "revision",
    "zones",
    "scenes",
    "mappings",
    "fallback_scene",
    "non_actuating",
    "preview_only"
  ],
  "properties": {
    "schema_version": {
      "const": "openrgd.visual-studio.profile.v0.1-candidate"
    },
    "robot_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "$ref": "#/$defs/intent"
        }
      }
    },
    "mappings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "fallback_scene": {
      "$ref": "#/$defs/name"
    },
    "non_actuating": {
      "const": true
    },
    "preview_only": {
      "const": true
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,99}$"
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "adapter_id",
        "capabilities",
        "binding_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "adapter_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "solid",
              "pulse",
              "chase",
              "wave"
            ]
          }
        },
        "binding_status": {
          "enum": [
            "planned",
            "operator_reported"
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "effect",
        "color",
        "brightness"
      ],
      "properties": {
        "zone_id": {
          "$ref": "#/$defs/name"
        },
        "effect": {
          "enum": [
            "solid",
            "pulse",
            "chase",
            "wave"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event",
        "scene",
        "priority"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/name"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "scene": {
          "$ref": "#/$defs/name"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
